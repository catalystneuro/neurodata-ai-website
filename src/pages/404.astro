---
import Base from "../layouts/Base.astro";
import { withBase } from "../lib/url";
---
<Base title="Page not found">
  <section class="section">
    <div class="container-x">
      <span class="eyebrow">404</span>
      <h1>Page not found</h1>
      <p class="lede">That address does not exist on this site. It may have moved when the program changed its name.</p>
      <p style="margin-top:1.5rem"><a href={withBase("/")} class="btn btn-primary">Go to the home page</a> <a href={withBase("/events/")} class="btn btn-secondary">Past events</a></p>
    </div>
  </section>
</Base>
