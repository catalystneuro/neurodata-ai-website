---
import { getEntry, render } from "astro:content";
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";
import ApplyBanner from "../components/ApplyBanner.astro";
import NewsletterCta from "../components/NewsletterCta.astro";
import { CURRENT_EVENT, SITE } from "../consts";
import { withBase } from "../lib/url";
import { applyState } from "../lib/apply";
import { dateRange } from "../lib/format";

const page = (await getEntry("pages", "apply"))!;
const { Content } = await render(page);
const current = (await getEntry("events", CURRENT_EVENT))!;
const cta = applyState(current, withBase("/apply/"), SITE.mailingList);
---
<Base title="Apply" description="Who should apply to the NeuroData AI Summer School, what the application asks for, and when to expect decisions.">
  <PageHeader eyebrow="Applications" title={`Apply to the ${CURRENT_EVENT} school`} subtitle={`${dateRange(current.data.startDate, current.data.endDate)} at ${current.data.venue.name}. No fee, lodging and meals provided, travel reimbursed up to $550.`} />
  <section class="section">
    <div class="container-x layout">
      <div class="main">
        <ApplyBanner event={current} applyPage />
        <div class="prose mt">
          <Content />
        </div>
      </div>
      <aside class="side">
        <div class="card side-card">
          <span class="label">At a glance</span>
          <dl class="kv">
            <dt>Dates</dt><dd>{dateRange(current.data.startDate, current.data.endDate)}</dd>
            <dt>Arrive</dt><dd>{current.data.arrivalDate ? `Evening of ${dateRange(current.data.arrivalDate)}` : ""}</dd>
            <dt>Where</dt><dd>{current.data.venue.name}, {current.data.venue.city}</dd>
            <dt>Places</dt><dd>About {current.data.stats.participants}</dd>
            <dt>Cost</dt><dd>None.</dd>
            <dt>Status</dt><dd>{cta.state === "open" ? "Applications open" : cta.state === "closed" ? "Applications closed" : `Opens ${current.data.applications?.opensOn ?? "soon"}`}</dd>
          </dl>
          {cta.state === "open" && cta.formUrl ? (
            <a href={cta.formUrl} class="btn btn-primary" target="_blank" rel="noopener">Apply now</a>
          ) : (
            <a href={cta.href} class="btn btn-primary" target="_blank" rel="noopener">Get notified</a>
          )}
        </div>
        <div class="card side-card">
          <span class="label">Questions</span>
          <p class="muted">Write to <a href={`mailto:${SITE.email}`} class="text-link">{SITE.email}</a>. For a sense of the week, see the <a href={withBase("/events/2026/")} class="text-link">2026 schedule and recordings</a>.</p>
        </div>
      </aside>
    </div>
  </section>
  <section class="section-tight"><div class="container-x"><NewsletterCta /></div></section>
</Base>

<style>
  .layout { display: grid; gap: 2rem; grid-template-columns: 1fr; }
  @media (min-width: 960px) { .layout { grid-template-columns: 1fr 19rem; gap: 3rem; } }
  .mt { margin-top: 2rem; }
  .side { display: flex; flex-direction: column; gap: 1rem; }
  .side-card { padding: 1.2rem 1.3rem; display: flex; flex-direction: column; gap: 0.9rem; }
  .side-card .kv { font-size: 0.95rem; }
  @media (min-width: 960px) { .side { position: sticky; top: 5.5rem; align-self: start; } }
</style>
