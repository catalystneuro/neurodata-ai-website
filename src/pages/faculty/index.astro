---
import { getCollection, getEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import PersonCard from "../../components/PersonCard.astro";
import { CURRENT_EVENT } from "../../consts";

const people = await getCollection("people");
const current = (await getEntry("events", CURRENT_EVENT))!;
const byName = (a: { data: { name: string; order?: number } }, b: { data: { name: string; order?: number } }) => (a.data.order ?? 999) - (b.data.order ?? 999) || a.data.name.localeCompare(b.data.name);
const director = people.filter((p) => p.data.roles.includes("director"));
const currentIds = new Set(current.data.instructors.map((r) => r.id));
const currentInstructors = people.filter((p) => currentIds.has(p.id) && !p.data.roles.includes("director")).sort(byName);
const past = people.filter((p) => (p.data.roles.includes("faculty") || p.data.roles.includes("guest")) && !currentIds.has(p.id) && !p.data.roles.includes("director")).sort((a, b) => a.data.name.localeCompare(b.data.name));
---
<Base title="Faculty" description="The director, instructors, and faculty of the NeuroData AI Summer School.">
  <PageHeader eyebrow="People" title="Faculty" subtitle="Instructors include the developers of NWB, DANDI, SpikeInterface, Pynapple, Neurosift, and suite2p, alongside researchers applying AI methods to neural data. Each faculty member gives one or two sessions and stays on site for at least three days to mentor projects." />
  <section class="section">
    <div class="container-x">
      <h2 class="section-title">Program director</h2>
      <div class="grid-2 mb">{director.map((p) => <PersonCard person={p} />)}</div>

      <h2 class="section-title">{CURRENT_EVENT} instructors announced so far</h2>
      <div class="grid-3 mb">{currentInstructors.map((p) => <PersonCard person={p} />)}</div>

      <h2 class="section-title">Past faculty</h2>
      <div class="grid-3">{past.map((p) => <PersonCard person={p} />)}</div>
    </div>
  </section>
</Base>

<style>
  .mb { margin-bottom: 3rem; }
</style>
