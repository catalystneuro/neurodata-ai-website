---
import { getCollection, getEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import PersonCard from "../../components/PersonCard.astro";
import { CURRENT_EVENT } from "../../consts";
import { yearsFor } from "../../lib/derive";

const people = await getCollection("people");
const current = (await getEntry("events", CURRENT_EVENT))!;
const byName = (a: { data: { name: string; order?: number } }, b: { data: { name: string; order?: number } }) => (a.data.order ?? 999) - (b.data.order ?? 999) || a.data.name.localeCompare(b.data.name);
const director = people.filter((p) => p.data.roles.includes("director"));
const currentIds = new Set(current.data.instructors.map((r) => r.id));
const currentInstructors = people.filter((p) => currentIds.has(p.id) && !p.data.roles.includes("director")).sort(byName);
const advisory = people.filter((p) => p.data.roles.includes("advisory")).sort((a, b) => a.data.name.localeCompare(b.data.name));
// Past faculty are people who taught, organized, or spoke at a past installment, not people named for a future one.
const taughtBefore = new Set<string>();
for (const p of people) if ((await yearsFor(p.id)).some((y) => y < CURRENT_EVENT)) taughtBefore.add(p.id);
const past = people.filter((p) => (p.data.roles.includes("faculty") || p.data.roles.includes("guest")) && taughtBefore.has(p.id) && !currentIds.has(p.id) && !p.data.roles.includes("director")).sort((a, b) => a.data.name.localeCompare(b.data.name));
---
<Base title="Faculty and advisory committee" description="The director, instructors, faculty, and advisory committee of the NeuroData AI Summer School.">
  <PageHeader title="Faculty and advisory committee" />
  <section class="section">
    <div class="container-x">
      <h2 class="section-title">Program director</h2>
      <div class="grid-2 mb">{director.map((p) => <PersonCard person={p} />)}</div>

      <h2 class="section-title">{CURRENT_EVENT} instructors announced so far</h2>
      <div class="grid-3 mb">{currentInstructors.map((p) => <PersonCard person={p} />)}</div>

      <h2 class="section-title">Past faculty</h2>
      <div class="grid-3 mb">{past.map((p) => <PersonCard person={p} />)}</div>

      <h2 class="section-title">Advisory committee</h2>
      <p class="muted intro">The committee reviews the curriculum and selection criteria each year, evaluates outcomes, and helps the school reach the right applicants. Further members will be announced as they are confirmed.</p>
      <div class="grid-3">{advisory.map((p) => <PersonCard person={p} />)}</div>
    </div>
  </section>
</Base>

<style>
  .mb { margin-bottom: 3rem; }
  .intro { margin-bottom: 1.25rem; margin-top: -0.75rem; }
</style>
