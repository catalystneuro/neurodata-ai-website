---
interface Props { quote: string; name: string; affiliation: string; eventLabel?: string }
const { quote, name, affiliation, eventLabel } = Astro.props;
---
<figure class="tq">
  <blockquote>“{quote}”</blockquote>
  <figcaption><span class="tq-name">{name}</span>, {affiliation}{eventLabel && <span class="tq-ev"> · {eventLabel}</span>}</figcaption>
</figure>

<style>
  .tq { padding-top: 0.9rem; border-top: 2px solid var(--color-sun); }
  .tq blockquote { font-family: var(--font-display); font-size: 1.2rem; line-height: 1.5; color: var(--color-ink); }
  .tq figcaption { margin-top: 0.6rem; font-size: 0.95rem; color: var(--color-ink-muted); }
  .tq-name { font-weight: 600; color: var(--color-ink); }
  .tq-ev { color: var(--color-ink-soft); }
</style>
