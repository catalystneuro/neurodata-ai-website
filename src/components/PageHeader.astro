---
interface Props { eyebrow?: string; title: string; subtitle?: string; count?: string }
const { eyebrow, title, subtitle, count } = Astro.props;
---
<section class="page-head">
  <div class="container-x">
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <div class="page-head-row">
      <h1>{title}</h1>
      {count && <span class="page-head-count tnum">{count}</span>}
    </div>
    {subtitle && <p class="lede page-head-sub">{subtitle}</p>}
    <slot />
  </div>
</section>

<style>
  .page-head { padding: 3rem 0 2rem; border-bottom: 1px solid var(--color-line); background: var(--color-surface); }
  .page-head-row { display: flex; align-items: baseline; gap: 1rem; flex-wrap: wrap; }
  .page-head h1 { font-size: clamp(2rem, 4.5vw, 3rem); }
  .page-head-count { font-size: 0.9rem; color: var(--color-ink-soft); padding: 0.15rem 0.6rem; border: 1px solid var(--color-line); border-radius: 999px; }
  .page-head-sub { margin-top: 0.9rem; }
</style>
