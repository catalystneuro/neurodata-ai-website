---
import type { CollectionEntry } from "astro:content";
import { withBase } from "../lib/url";
interface Props { sponsors: CollectionEntry<"sponsors">[]; title?: string; size?: "md" | "sm" }
const { sponsors, title, size = "md" } = Astro.props;
---
<div class="logos">
  {title && <span class="label logos-title">{title}</span>}
  <div class:list={["logo-row", size === "sm" && "logo-row--sm"]}>
    {sponsors.map((s) => (
      <a href={s.data.url} target="_blank" rel="noopener" class="logo" title={s.data.name}>
        <img src={withBase(s.data.logo)} alt={s.data.name} loading="lazy" />
      </a>
    ))}
  </div>
</div>

<style>
  .logos-title { display: block; margin-bottom: 1rem; }
  .logo-row { display: flex; flex-wrap: wrap; gap: 1.5rem 3rem; align-items: center; }
  .logo img { height: 48px; width: auto; max-width: 180px; object-fit: contain; }
  .logo-row--sm .logo img { height: 34px; }
</style>
