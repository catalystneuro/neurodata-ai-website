---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
interface Photo { image: ImageMetadata; alt: string; caption?: string }
interface Props { photos: Photo[]; lead?: Photo }
const { photos, lead } = Astro.props;
---
<div class="gal">
  {lead && (
    <figure class="gal-lead">
      <Image src={lead.image} alt={lead.alt} widths={[800, 1200, 1800]} sizes="(min-width: 72rem) 72rem, 100vw" loading="lazy" />
      {lead.caption && <figcaption>{lead.caption}</figcaption>}
    </figure>
  )}
  {photos.length > 0 && (
    <div class="gal-grid">
      {photos.map((p) => (
        <figure class="gal-item">
          <Image src={p.image} alt={p.alt} widths={[400, 700, 1000]} sizes="(min-width: 960px) 24rem, (min-width: 640px) 50vw, 100vw" loading="lazy" />
          {p.caption && <figcaption>{p.caption}</figcaption>}
        </figure>
      ))}
    </div>
  )}
</div>

<style>
  .gal-lead img { width: 100%; height: auto; border-radius: 0.6rem; border: 1px solid var(--color-line); }
  .gal-lead figcaption, .gal-item figcaption { font-size: 0.88rem; color: var(--color-ink-soft); margin-top: 0.4rem; }
  .gal-grid { display: grid; gap: 0.9rem; grid-template-columns: repeat(2, 1fr); margin-top: 0.9rem; }
  @media (min-width: 960px) { .gal-grid { grid-template-columns: repeat(3, 1fr); } }
  .gal-item img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 0.5rem; border: 1px solid var(--color-line); }
</style>
