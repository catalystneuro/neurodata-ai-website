---
import { Image, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
interface Photo { image: ImageMetadata; alt: string; caption?: string }
interface Props { photos: Photo[]; lead?: Photo }
const { photos, lead } = Astro.props;
const all = [...(lead ? [lead] : []), ...photos];
const full = await Promise.all(all.map((p) => getImage({ src: p.image, width: 2000, format: "webp", quality: 85 })));
const fullSrc = (i: number) => full[i]!.src;
---
<div class="gal">
  {lead && (
    <figure class="gal-lead">
      <a href={fullSrc(0)} data-lightbox data-alt={lead.alt} aria-label={`Enlarge: ${lead.alt}`}>
        <Image src={lead.image} alt={lead.alt} widths={[800, 1200, 1800]} sizes="(min-width: 72rem) 72rem, 100vw" loading="lazy" />
      </a>
      {lead.caption && <figcaption>{lead.caption}</figcaption>}
    </figure>
  )}
  {photos.length > 0 && (
    <div class="gal-grid">
      {photos.map((p, i) => (
        <figure class="gal-item">
          <a href={fullSrc(i + (lead ? 1 : 0))} data-lightbox data-alt={p.alt} aria-label={`Enlarge: ${p.alt}`}>
            <Image src={p.image} alt={p.alt} widths={[400, 700, 1000]} sizes="(min-width: 960px) 24rem, (min-width: 640px) 50vw, 100vw" loading="lazy" />
          </a>
          {p.caption && <figcaption>{p.caption}</figcaption>}
        </figure>
      ))}
    </div>
  )}
</div>

<dialog class="lb" id="lightbox" aria-label="Enlarged photo">
  <button type="button" class="lb-close" aria-label="Close">×</button>
  <button type="button" class="lb-nav lb-prev" aria-label="Previous photo">‹</button>
  <img alt="" />
  <button type="button" class="lb-nav lb-next" aria-label="Next photo">›</button>
  <p class="lb-cap"></p>
</dialog>

<style>
  .gal-lead img, .gal-item img { display: block; }
  .gal-lead a, .gal-item a { display: block; cursor: zoom-in; border-radius: 0.6rem; }
  .gal-lead img { width: 100%; height: auto; border-radius: 0.6rem; border: 1px solid var(--color-line); }
  .gal-lead figcaption, .gal-item figcaption { font-size: 0.88rem; color: var(--color-ink-soft); margin-top: 0.4rem; }
  .gal-grid { display: grid; gap: 0.9rem; grid-template-columns: repeat(2, 1fr); margin-top: 0.9rem; }
  @media (min-width: 960px) { .gal-grid { grid-template-columns: repeat(3, 1fr); } }
  .gal-item img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 0.5rem; border: 1px solid var(--color-line); transition: opacity 0.15s; }
  .gal-item a:hover img, .gal-lead a:hover img { opacity: 0.92; }

  .lb { border: 0; padding: 0; background: transparent; max-width: 100vw; max-height: 100vh; width: 100vw; height: 100vh; margin: 0; }
  .lb::backdrop { background: rgba(18, 32, 26, 0.92); }
  .lb[open] { display: grid; place-items: center; }
  .lb img { max-width: min(96vw, 1800px); max-height: 86vh; width: auto; height: auto; border-radius: 0.4rem; box-shadow: 0 20px 60px rgba(0,0,0,0.5); }
  .lb-cap { position: absolute; left: 0; right: 0; bottom: 1.2rem; text-align: center; color: rgba(255,255,255,0.85); font-size: 0.95rem; padding: 0 3rem; }
  .lb-close, .lb-nav { position: absolute; background: rgba(255,255,255,0.12); color: #fff; border: 0; border-radius: 50%; width: 2.8rem; height: 2.8rem; font-size: 1.8rem; line-height: 1; cursor: pointer; display: grid; place-items: center; }
  .lb-close:hover, .lb-nav:hover { background: rgba(255,255,255,0.25); }
  .lb-close { top: 1rem; right: 1rem; }
  .lb-nav { top: 50%; transform: translateY(-50%); }
  .lb-prev { left: 1rem; } .lb-next { right: 1rem; }
  @media (max-width: 640px) { .lb-nav { width: 2.2rem; height: 2.2rem; font-size: 1.4rem; } }
</style>

<script>
  const dlg = document.getElementById("lightbox") as HTMLDialogElement | null;
  const links = [...document.querySelectorAll<HTMLAnchorElement>("a[data-lightbox]")];
  if (dlg && links.length) {
    const img = dlg.querySelector("img")!;
    const cap = dlg.querySelector<HTMLElement>(".lb-cap")!;
    let index = 0;
    const show = (i: number) => {
      index = (i + links.length) % links.length;
      const a = links[index]!;
      img.src = a.href;
      img.alt = a.dataset.alt ?? "";
      cap.textContent = a.dataset.alt ?? "";
    };
    links.forEach((a, i) => a.addEventListener("click", (e) => { e.preventDefault(); show(i); dlg.showModal(); }));
    dlg.querySelector(".lb-close")!.addEventListener("click", () => dlg.close());
    dlg.querySelector(".lb-prev")!.addEventListener("click", (e) => { e.stopPropagation(); show(index - 1); });
    dlg.querySelector(".lb-next")!.addEventListener("click", (e) => { e.stopPropagation(); show(index + 1); });
    dlg.addEventListener("click", (e) => { if (e.target === dlg) dlg.close(); });
    dlg.addEventListener("keydown", (e) => { if (e.key === "ArrowRight") show(index + 1); if (e.key === "ArrowLeft") show(index - 1); });
    dlg.addEventListener("close", () => { img.removeAttribute("src"); });
  }
</script>
