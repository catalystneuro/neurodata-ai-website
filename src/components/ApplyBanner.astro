---
import type { CollectionEntry } from "astro:content";
import { SITE } from "../consts";
import { withBase } from "../lib/url";
import { applyState } from "../lib/apply";
import { dateRange } from "../lib/format";
interface Props { event: CollectionEntry<"events">; variant?: "inline" | "compact" }
const { event, variant = "inline" } = Astro.props;
const cta = applyState(event, withBase(`/events/${event.id}/`), SITE.mailingList);
// This banner sits on the event page, which is where the application details live, so it links straight to the form.
const direct = cta.state === "open" && cta.formUrl;
const href = direct ? cta.formUrl : cta.href;
const label = direct ? "Apply now" : cta.label;
const attrs = direct || cta.external ? { target: "_blank", rel: "noopener" } : {};
---
<div class:list={["apply", `apply--${cta.state}`, variant === "compact" && "apply--compact"]}>
  <div class="apply-text">
    <strong>{event.data.name}</strong>, {dateRange(event.data.startDate, event.data.endDate)}, {event.data.venue.name}. {cta.sentence}
    {event.data.applications?.note && cta.state === "not_open" && <span class="muted"> {event.data.applications.note}</span>}
  </div>
  <div class="apply-actions">
    <a href={href} class="btn btn-primary btn-sm" {...attrs}>{label}</a>
  </div>
</div>

<style>
  .apply { display: flex; flex-wrap: wrap; gap: 0.9rem 1.5rem; align-items: center; justify-content: space-between; padding: 1rem 1.25rem; border-radius: 0.6rem; background: var(--color-pine-50); border: 1px solid var(--color-pine-100); }
  .apply--open { background: var(--color-sun-100); border-color: var(--color-sun-200); }
  .apply-text { flex: 1 1 24rem; font-size: 1rem; line-height: 1.5; }
  .apply-actions { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .apply--compact { padding: 0.75rem 1rem; }
</style>
