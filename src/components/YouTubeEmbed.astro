---
import { youtubeThumb, youtubeWatch } from "../lib/youtube";
import Icon from "./Icon.astro";
interface Props { id: string; title: string; class?: string }
const { id, title, class: cls = "" } = Astro.props;
---
<a class:list={["yt", cls]} href={youtubeWatch(id)} target="_blank" rel="noopener" data-yt={id} aria-label={`Play: ${title}`}>
  <img src={youtubeThumb(id, "hq")} alt="" loading="lazy" width="480" height="360" />
  <span class="yt-play"><Icon name="play" size={26} /></span>
</a>

<style>
  .yt { position: relative; display: block; aspect-ratio: 16 / 9; width: 100%; border-radius: 0.6rem; overflow: hidden; background: #000; border: 1px solid var(--color-line); }
  .yt img { width: 100%; height: 100%; object-fit: cover; display: block; opacity: 0.95; transition: opacity 0.15s; }
  .yt:hover img { opacity: 1; }
  .yt-play { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; }
  .yt-play :global(svg) { width: 60px; height: 60px; padding: 15px; border-radius: 50%; background: rgba(20,86,63,0.92); color: #fff; box-shadow: 0 6px 20px rgba(0,0,0,0.35); transition: background 0.15s; }
  .yt:hover .yt-play :global(svg) { background: var(--color-pine); }
  .yt :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
</style>

<script>
  // Plain clicks swap the link for the player; modified or middle clicks open YouTube as usual.
  document.addEventListener("click", (e) => {
    const a = (e.target as HTMLElement).closest<HTMLAnchorElement>("a[data-yt]");
    if (!a || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
    e.preventDefault();
    const id = a.dataset.yt!;
    const title = (a.getAttribute("aria-label") ?? "Video").replace(/^Play: /, "");
    const iframe = document.createElement("iframe");
    iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
    iframe.title = title;
    iframe.allow = "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
    iframe.setAttribute("allowfullscreen", "");
    // A div in place of the link, keeping its classes and Astro's scoping attribute so the styles still apply.
    const box = document.createElement("div");
    for (const attr of a.attributes) if (attr.name === "class" || attr.name.startsWith("data-astro-cid")) box.setAttribute(attr.name, attr.value);
    box.appendChild(iframe);
    a.replaceWith(box);
    iframe.focus();
  });
</script>
